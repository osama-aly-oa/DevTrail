{
  "name": "devtrail-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run --exclude test/postgres.test.ts",
    "test:watch": "vitest --exclude test/postgres.test.ts",
    "test:db": "vitest run test/postgres.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "connect-pg-simple": "10.0.0",
    "cookie-signature": "1.2.2",
    "express": "^5.0.0",
    "express-rate-limit": "8.7.5",
    "express-session": "1.19.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-signature": "1.1.2",
    "@types/express": "^5.0.0",
    "@types/express-session": "1.19.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
