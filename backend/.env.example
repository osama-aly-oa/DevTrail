PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://devtrail:replace-locally@127.0.0.1:5432/devtrail
# Generate a new value with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))".
SESSION_SECRET=
# Required only when provisioning the owner with npm run db:seed.
OWNER_USERNAME=
OWNER_PASSWORD=
# When HTTPS is terminated at a proxy, set only the trusted proxy IP addresses.
# TRUSTED_PROXY_IPS=127.0.0.1

# Optional for public repositories, required for authorized private repositories.
# On each selected repository, grant read access to Contents and Pull requests.
# GITHUB_TOKEN=
